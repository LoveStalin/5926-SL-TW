rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function owns(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function profilePath(uid) {
      return /databases/$(database)/documents/users/$(uid);
    }

    function hasProfile() {
      return signedIn() && exists(profilePath(request.auth.uid));
    }

    function myProfile() {
      return get(profilePath(request.auth.uid)).data;
    }

    function activeUser() {
      return hasProfile() && myProfile().accountStatus == "active";
    }

    function isProjectMember() {
      return activeUser() && myProfile().role == "project_member";
    }

    function isStaff() {
      return activeUser() && myProfile().role in ["teacher", "admin"];
    }

    function validTitle(data) {
      return data.title is string
        && data.title.size() >= 3
        && data.title.size() <= 160;
    }

    function validContentType(data) {
      return data.contentType in [
        "ebook", "article", "video", "podcast", "postcard",
        "artwork", "design", "digital_product", "document", "audio"
      ];
    }

    function validLegacyType(data) {
      return !("type" in data)
        || data.type in ["image", "pdf", "audio", "video", "document"];
    }

    function validLibraryItemFields(data) {
      return data.keys().hasOnly([
          "schemaVersion", "title", "slug", "description", "contentType", "type",
          "authors", "authorNamesNormalized", "categoryId", "tags", "language",
          "metadata", "reader", "qrCode", "submittedBy", "submittedByName",
          "publishedBy", "approvedBy", "status", "fileStatus", "createdBy",
          "createdAt", "updatedAt", "publishedAt"
        ])
        && data.keys().hasAll([
          "schemaVersion", "title", "contentType", "status", "fileStatus",
          "submittedBy", "publishedBy", "createdBy", "createdAt",
          "updatedAt", "publishedAt", "qrCode"
        ]);
    }

    function validLibraryItem(data) {
      return validLibraryItemFields(data)
        && data.schemaVersion is int
        && data.schemaVersion == 2
        && validTitle(data)
        && validContentType(data)
        && validLegacyType(data)
        && data.slug is string
        && data.slug.size() <= 120
        && data.description is string
        && data.description.size() <= 3000
        && data.authors is list
        && data.authorNamesNormalized is list
        && data.categoryId is string
        && data.categoryId.size() <= 80
        && data.tags is list
        && data.language is string
        && data.language.size() >= 2
        && data.language.size() <= 19
        && data.metadata is map
        && data.reader is map
        && data.qrCode is map
        && data.qrCode.enabled is bool
        && (data.qrCode.targetPath == null || data.qrCode.targetPath is string)
        && data.submittedBy is string
        && data.submittedByName is string
        && data.publishedBy is string
        && data.createdBy is string
        && data.status in ["published", "archived"]
        && data.fileStatus in ["awaiting_upload", "uploaded"]
        && data.createdAt is timestamp
        && data.updatedAt is timestamp
        && data.publishedAt is timestamp
        && (!("approvedBy" in data) || data.approvedBy is string);
    }

    function validAssetFields(data) {
      return data.keys().hasOnly([
          "assetType", "format", "storageProvider", "storageKey",
          "mimeType", "sizeBytes", "checksum", "isPrimary",
          "access", "createdAt", "createdBy"
        ])
        && data.keys().hasAll([
          "assetType", "format", "storageProvider", "storageKey",
          "createdAt", "createdBy"
        ]);
    }

    function validAsset(data, itemId, assetId) {
      return validAssetFields(data)
        && data.assetType in ["cover", "original", "preview", "thumbnail", "attachment"]
        && data.format is string
        && data.format.size() >= 1
        && data.format.size() <= 20
        && data.storageProvider in ["dev", "b2"]
        && data.storageKey is string
        && data.storageKey.size() >= 1
        && data.storageKey.size() <= 500
        && data.storageKey.matches("library/" + itemId + "/" + assetId + "\\.[a-z0-9]{1,20}")
        && data.createdAt is timestamp
        && data.createdBy is string
        && (!("mimeType" in data) || data.mimeType is string)
        && (!("sizeBytes" in data) || (data.sizeBytes is int && data.sizeBytes >= 0))
        && (!("checksum" in data) || data.checksum is string)
        && (!("isPrimary" in data) || data.isPrimary is bool)
        && (!("access" in data) || data.access in ["public", "private"]);
    }

    match /users/{userId} {
      allow get: if owns(userId);
      allow list: if false;

      allow create: if owns(userId)
        && request.resource.data.keys().hasOnly([
          "email", "displayName", "audienceType", "role", "accountStatus", "createdAt"
        ])
        && request.resource.data.keys().hasAll([
          "email", "audienceType", "role", "accountStatus", "createdAt"
        ])
        && request.resource.data.email is string
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.audienceType in ["guest", "student"]
        && request.resource.data.role == "viewer"
        && request.resource.data.accountStatus == "active"
        && request.resource.data.createdAt is timestamp
        && (!("displayName" in request.resource.data) || request.resource.data.displayName is string);

      allow update, delete: if false;
    }

    match /submissions/{submissionId} {
      allow create: if activeUser()
        && request.resource.data.keys().hasOnly([
          "schemaVersion", "title", "slug", "description", "contentType", "type",
          "authors", "authorNamesNormalized", "categoryId", "tags", "language",
          "metadata", "reader", "status", "fileStatus", "submittedBy",
          "submittedByName", "submittedAt"
        ])
        && request.resource.data.keys().hasAll([
          "schemaVersion", "title", "contentType", "status", "fileStatus",
          "submittedBy", "submittedAt"
        ])
        && request.resource.data.schemaVersion == 2
        && request.resource.data.submittedBy == request.auth.uid
        && request.resource.data.status == "pending"
        && request.resource.data.fileStatus == "awaiting_upload"
        && validTitle(request.resource.data)
        && validContentType(request.resource.data)
        && validLegacyType(request.resource.data)
        && request.resource.data.submittedAt is timestamp;

      allow get, list: if activeUser()
        && (resource.data.submittedBy == request.auth.uid || isStaff());

      allow update: if isStaff()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "status", "libraryItemId", "reviewedBy", "reviewedAt", "reviewNote"
        ])
        && request.resource.data.status in ["pending", "approved", "rejected"]
        && (!("libraryItemId" in request.resource.data) || request.resource.data.libraryItemId is string)
        && (!("reviewedBy" in request.resource.data) || request.resource.data.reviewedBy == request.auth.uid)
        && (!("reviewedAt" in request.resource.data) || request.resource.data.reviewedAt is timestamp)
        && (!("reviewNote" in request.resource.data) || request.resource.data.reviewNote is string);

      allow delete: if false;
    }

    match /libraryItems/{itemId} {
      allow get, list: if resource.data.status == "published" || isStaff();

      allow create: if (
        isStaff()
        && validLibraryItem(request.resource.data)
        && request.resource.data.submittedBy == request.auth.uid
        && request.resource.data.publishedBy == request.auth.uid
        && request.resource.data.createdBy == request.auth.uid
      ) || (
        isProjectMember()
        && validLibraryItem(request.resource.data)
        && request.resource.data.submittedBy == request.auth.uid
        && request.resource.data.publishedBy == request.auth.uid
        && request.resource.data.createdBy == request.auth.uid
      );

      allow update: if (
        isStaff()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "status", "archivedBy", "archivedAt", "updatedAt", "fileStatus"
        ])
        && request.resource.data.status in ["published", "archived"]
        && request.resource.data.fileStatus in ["awaiting_upload", "uploaded"]
        && request.resource.data.updatedAt is timestamp
        && (
          (
            request.resource.data.status == resource.data.status
            && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
              "archivedBy", "archivedAt"
            ])
          )
          || (
            request.resource.data.status == "archived"
            && request.resource.data.archivedBy == request.auth.uid
            && request.resource.data.archivedAt is timestamp
          )
        )
      ) || (
        isProjectMember()
        && resource.data.createdBy == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "fileStatus", "updatedAt"
        ])
        && request.resource.data.fileStatus == "uploaded"
        && request.resource.data.updatedAt is timestamp
      );

      // The Worker performs the storage cleanup before this Firestore delete.
      // Because the Worker currently forwards the user's Firebase ID token,
      // Firestore cannot distinguish that Worker request from a direct staff
      // client request at the rules layer.
      allow delete: if isStaff();
    }

    match /libraryItems/{itemId}/assets/{assetId} {
      allow get, list: if
        get(/databases/$(database)/documents/libraryItems/$(itemId)).data.status == "published"
        || isStaff();

      allow create: if isStaff()
        && validAsset(request.resource.data, itemId, assetId)
        || (isProjectMember()
          && get(/databases/$(database)/documents/libraryItems/$(itemId)).data.createdBy == request.auth.uid
          && validAsset(request.resource.data, itemId, assetId)
          && request.resource.data.createdBy == request.auth.uid);

      // The Worker performs the corresponding B2/R2 operation before deleting
      // the Firestore asset record.
      allow update, delete: if isStaff();
    }

    match /moderationLogs/{logId} {
      allow get, list: if isStaff();

      allow create: if isStaff()
        && request.resource.data.keys().hasOnly([
          "action", "submissionId", "libraryItemId", "actorUid", "reason", "createdAt"
        ])
        && request.resource.data.keys().hasAll([
          "action", "actorUid", "createdAt"
        ])
        && request.resource.data.action in ["approve", "reject", "archive", "delete"]
        && request.resource.data.actorUid == request.auth.uid
        && request.resource.data.createdAt is timestamp
        && (!("submissionId" in request.resource.data) || request.resource.data.submissionId is string)
        && (!("libraryItemId" in request.resource.data) || request.resource.data.libraryItemId is string)
        && (!("reason" in request.resource.data) || request.resource.data.reason is string);

      allow update, delete: if false;
    }

    match /categories/{categoryId} {
      allow get, list: if true;
      allow create, update, delete: if isStaff();
    }

    match /siteConfig/{configId} {
      allow get: if true;
      allow list, create, update, delete: if isStaff();
    }

    match /bookReviews/{reviewId} {
      allow get, list: if resource.data.status == "published";

      allow create: if activeUser()
        && request.resource.data.keys().hasOnly([
          "userId", "displayName", "rating", "content", "status", "createdAt", "updatedAt"
        ])
        && request.resource.data.keys().hasAll([
          "userId", "rating", "content", "status", "createdAt"
        ])
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.rating is int
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5
        && request.resource.data.content is string
        && request.resource.data.content.size() <= 2000
        && request.resource.data.status == "pending"
        && request.resource.data.createdAt is timestamp
        && (!("displayName" in request.resource.data) || request.resource.data.displayName is string)
        && (!("updatedAt" in request.resource.data) || request.resource.data.updatedAt is timestamp);

      allow update: if isStaff()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "status", "content", "rating", "updatedAt"
        ])
        && request.resource.data.status in ["pending", "published", "rejected"]
        && request.resource.data.rating is int
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5
        && request.resource.data.content is string
        && request.resource.data.content.size() <= 2000
        && request.resource.data.updatedAt is timestamp;

      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
